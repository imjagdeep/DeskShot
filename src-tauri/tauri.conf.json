{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskShot",
  "version": "0.2.1",
  "identifier": "app.deskshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeskShot",
        "width": 1100,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost blob: data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Jagdeep Sandhu",
    "copyright": "Copyright (c) 2026 Jagdeep Sandhu. MIT License.",
    "category": "Productivity",
    "shortDescription": "Offline screenshots",
    "longDescription": "DeskShot captures an area, a window or the whole screen, lets you mark it up, blur private details, copy the text and pin it on top. Offline, private, no account.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.3"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4QTJCM0I2Qzg1NEZBREUKUldUZStsVEl0ck9pcVAwZTI0K0orZVNZZFZVbUxWQU5WVkIyM21iemJ3MktQVWhnSGZ0V2FvRWQK",
      "endpoints": [
        "https://github.com/imjagdeep/DeskShot/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
